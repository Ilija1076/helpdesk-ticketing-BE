              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Return the authenticated user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/users": {
      "get": {
        "operationId": "UsersController_findMany",
        "parameters": [
          {
            "name": "role",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CLIENT",
                "AGENT"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuthUserDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List users, typically to populate an assignee picker",
        "tags": [
          "users"
        ]
      }
    },
    "/api/tickets": {
      "post": {
        "operationId": "TicketsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTicketDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Raise a ticket, stamping its SLA deadlines",
        "tags": [
          "tickets"
        ]
      },
      "get": {
        "operationId": "TicketsController_findMany",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "IN_PROGRESS",
                  "WAITING_ON_CUSTOMER",
                  "RESOLVED",
                  "CLOSED"
                ]
              }
            }
          },
          {
            "name": "priority",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "URGENT"
                ]
              }
            }
          },
          {
            "name": "assigneeId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requesterId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "breached",
            "required": false,
            "in": "query",
            "description": "Only tickets that have breached any SLA clock",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "unassigned",
            "required": false,
            "in": "query",
            "description": "Only tickets with no assignee",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Case-insensitive match on title and description",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "schema": {
              "default": "createdAt",
              "type": "string",
              "enum": [
                "createdAt",
                "updatedAt",
                "priority",
                "resolutionDueAt"
              ]
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/TicketDto"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List tickets; clients only ever see their own",
        "tags": [
          "tickets"
        ]
      }
    },
    "/api/tickets/stats": {
      "get": {
        "operationId": "TicketsController_stats",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketStatsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Aggregate counts for the agent dashboard",
        "tags": [
          "tickets"
        ]
      }
    },
    "/api/tickets/{id}": {
      "get": {
        "operationId": "TicketsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Fetch a single ticket",
        "tags": [
          "tickets"
        ]
      },
      "patch": {
        "operationId": "TicketsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTicketDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update a ticket; status and priority changes move the SLA clock",
        "tags": [
          "tickets"
        ]
      }
    },
    "/api/tickets/{ticketId}/comments": {
      "post": {
        "operationId": "CommentsController_create",
        "parameters": [
          {
            "name": "ticketId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCommentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Add a comment; an agent reply stops the first-response clock",
        "tags": [
          "comments"
        ]
      },
      "get": {
        "operationId": "CommentsController_findMany",
        "parameters": [
          {
            "name": "ticketId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CommentDto"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List comments; internal notes are hidden from clients",
        "tags": [
          "comments"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness and dependency check",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Helpdesk Ticketing API",
    "description": "Ticketing backend with business-hours SLA tracking",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "name": {
            "type": "string",
            "example": "Ana Anić"
          },
          "password": {
            "type": "string",
            "example": "super-secret-password",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "CLIENT",
              "AGENT"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived bearer token"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque token, rotated on every use"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "agent@example.com"
          },
          "password": {
            "type": "string",
            "example": "super-secret-password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token issued by login, register or a previous refresh"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateTicketDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "VPN klijent ne uspostavlja konekciju"
          },
          "description": {
            "type": "string",
            "example": "Od jutros dobijam error 809 pri konektovanju sa laptopa."
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ],
            "default": "MEDIUM"
          }
        },
        "required": [
          "title",
          "description"
        ]
      },
      "TicketPartyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "CLIENT",
              "AGENT"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "SlaClockDto": {
        "type": "object",
        "properties": {
          "dueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "metAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "breachedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TicketSlaDto": {
        "type": "object",
        "properties": {
          "firstResponse": {
            "$ref": "#/components/schemas/SlaClockDto"
          },
          "resolution": {
            "$ref": "#/components/schemas/SlaClockDto"
          },
          "pausedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pausedMinutes": {
            "type": "number"
          },
          "policyName": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "firstResponse",
          "resolution",
          "pausedMinutes"
        ]
      },
      "TicketDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "example": "HD-1042"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "WAITING_ON_CUSTOMER",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ]
          },
          "requester": {
            "$ref": "#/components/schemas/TicketPartyDto"
          },
          "assignee": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/TicketPartyDto"
              }
            ]
          },
          "sla": {
            "$ref": "#/components/schemas/TicketSlaDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "reference",
          "title",
          "description",
          "status",
          "priority",
          "requester",
          "sla",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "PaginatedDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "TicketStatsDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "open": {
            "type": "number",
            "description": "Tickets not yet resolved or closed"
          },
          "breached": {
            "type": "number",
            "description": "Tickets that have breached either SLA clock"
          },
          "unassigned": {
            "type": "number",
            "description": "Open tickets with no assignee"
          },
          "byStatus": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "example": {
              "OPEN": 4,
              "IN_PROGRESS": 2
            }
          },
          "byPriority": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "example": {
              "LOW": 1,
              "URGENT": 3
            }
          }
        },
        "required": [
          "total",
          "open",
          "breached",
          "unassigned",
          "byStatus",
          "byPriority"
        ]
      },
      "UpdateTicketDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "WAITING_ON_CUSTOMER",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ]
          },
          "assigneeId": {
            "type": "object",
            "nullable": true,
            "description": "Pass null to unassign"
          }
        }
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "example": "Proverili smo logove, problem je u sertifikatu."
          },
          "isInternal": {
            "type": "boolean",
            "default": false,
            "description": "Agents only; hidden from the requester"
          }
        },
        "required": [
          "body"
        ]
      },
      "CommentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ticketId": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "isInternal": {
            "type": "boolean"
          },
          "author": {
            "$ref": "#/components/schemas/TicketPartyDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ticketId",
          "body",
          "isInternal",
          "author",
          "createdAt"
        ]
      }
    }
  }
}
